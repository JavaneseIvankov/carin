# Copy to .env in this directory; values are loaded as data, never shell code.
# Use the API key and compatible-mode endpoint from the SAME Model Studio region.
DASHSCOPE_API_KEY=
VLM_BASE_URL=https://YOUR_WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# Requested primary snapshot; confirm availability in your workspace.
VLM_MODEL=qwen3.7-flash-2026-07-15
# Optional IMAGE-capable fallback on the same endpoint/key, e.g. qwen3-vl-flash.
# deepseek-v4-flash-0731 is text-only and cannot be used for this image task.
VLM_FALLBACK_MODEL=qwen3.7-flash
VLM_ENABLE_THINKING=false
VLM_JSON_MODE=true
VLM_TIMEOUT_SECONDS=120
VLM_MAX_RETRIES=2
VLM_MAX_TOKENS=1024
