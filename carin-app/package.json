{
  "name": "carin",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "vitest run .unit.test. --passWithNoTests",
    "test:integration": "vitest run .integration.test. --passWithNoTests",
    "dev": "expo start -c",
    "android": "expo start -c --android",
    "ios": "expo start -c --ios",
    "web": "expo start -c --web",
    "clean": "rm -rf .expo node_modules",
    "contracts:generate": "node ../scripts/generate-contracts.mjs",
    "contracts:check": "node ../scripts/generate-contracts.mjs --check"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.7",
    "@expo/dom-webview": "~57.0.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@rn-primitives/portal": "1.4.0",
    "@rn-primitives/slot": "1.5.2",
    "@tanstack/react-query": "^5.104.2",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "expo": "57.0.29",
    "expo-camera": "~57.0.6",
    "expo-constants": "57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-file-system": "~57.0.7",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "57.0.13",
    "expo-network": "~57.0.2",
    "expo-router": "57.0.27",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "57.0.10",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "lucide-react-native": "1.55.0",
    "nativewind": "4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@types/react": "19.2.18",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  },
  "private": true,
  "packageManager": "pnpm@10.33.0"
}
