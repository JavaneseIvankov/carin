# Shared only between the backend worker and this AI service.
AI_SERVICE_KEY=

# Maximum authenticated internal API requests per minute for this service process.
API_RATE_LIMIT_PER_MINUTE=5
REQUEST_MAX_BYTES=65536

# Alibaba Model Studio OpenAI-compatible endpoint and image-capable Qwen model.
DASHSCOPE_API_KEY=
VLM_BASE_URL=
# Used by /internal/v1/analyses. The A1V1 experiment routes pin their own model IDs.
VLM_MODEL=qwen3.7-flash-2026-07-15
VLM_FALLBACK_MODEL=qwen3.7-flash
VLM_TIMEOUT_SECONDS=35

# Exact signed MinIO hostnames, optionally with ports. Do not use wildcards.
MEDIA_ALLOWED_HOSTS=minio:9000
MEDIA_MAX_BYTES=10485760
