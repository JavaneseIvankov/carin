# Local development only. Copy to infra/.env. These are placeholders, not deployable secrets.
POSTGRES_DB=carin_dev
POSTGRES_USER=carin_dev
POSTGRES_PASSWORD=replace-with-a-local-only-password

MINIO_ROOT_USER=replace-with-a-local-only-username
MINIO_ROOT_PASSWORD=replace-with-a-local-only-password
MINIO_BUCKET=carin-dev
# Least-privilege S3 account for the future worker profile; create it in Silo
# before enabling that profile.
MINIO_ACCESS_KEY=replace-before-enabling-worker
MINIO_SECRET_KEY=replace-before-enabling-worker

# Bind the API to the host LAN so physical devices can reach it. Set to 127.0.0.1
# if only host-local access is needed.
API_BIND_ADDRESS=0.0.0.0
API_PORT=3000

# Better Auth server configuration. Keep BETTER_AUTH_URL aligned with the
# reachable EXPO_PUBLIC_API_URL below; generate a unique secret of at least 32 characters.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://192.168.1.50:3000
AUTH_TRUSTED_ORIGINS=carin-dev://
APP_LINK_SCHEME=carin-dev

# Used only by the optional email-worker Compose profile. Set a Resend API key
# and a sender on a domain verified for this environment before enabling it.
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM="Carin <auth@example.com>"

# Set this to the development machine's LAN IP for a physical phone. For Android
# emulator, 10.0.2.2 usually routes to the host. Never use localhost on a phone.
EXPO_PUBLIC_API_URL=http://192.168.1.50:3000

# Used only by the opt-in worker profile after C16 provides its entrypoint.
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_KEY=replace-before-enabling-worker
AI_MODE=fixture
