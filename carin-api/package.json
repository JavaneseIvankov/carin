{
  "name": "carin-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "vitest run .unit.test. --passWithNoTests",
    "test:integration": "vitest run .integration.test. --passWithNoTests"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "ajv": "8.20.0",
    "ajv-formats": "2.1.1",
    "hono": "4.13.13",
    "pg": "8.23.1"
  }
}
