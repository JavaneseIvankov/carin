{
  "name": "carin-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test:ai-fixture-runtime": "pnpm run build && node scripts/smoke-ai-fixtures.mjs",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "vitest run .unit.test. --passWithNoTests",
    "test:integration": "vitest run .integration.test. --passWithNoTests",
    "auth:generate": "auth generate --config ./src/auth/generation.ts --adapter drizzle --dialect postgresql --output ./src/db/schema/auth.ts --yes",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/db/migrate.js"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "auth": "1.7.7",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.7",
    "@hono/node-server": "2.1.5",
    "ajv": "8.20.0",
    "ajv-formats": "2.1.1",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "pg": "8.23.1"
  }
}
